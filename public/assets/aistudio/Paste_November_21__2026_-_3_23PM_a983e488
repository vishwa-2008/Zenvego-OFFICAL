<script>
  function switchAuthTab(mode) {
    const signInTab = document.getElementById('tab-signin');
    const signUpTab = document.getElementById('tab-signup');
    const ctaText = document.getElementById('cta-text');

    if (mode === 'signin') {
      signInTab.className = 'h-10 rounded-lg bg-surface-container-lowest text-primary shadow-sm font-label-lg text-label-lg transition-all flex items-center justify-center';
      signInTab.setAttribute('aria-selected', 'true');
      signUpTab.className = 'h-10 rounded-lg text-on-surface-variant font-label-lg text-label-lg transition-all flex items-center justify-center hover:text-on-surface';
      signUpTab.setAttribute('aria-selected', 'false');
      ctaText.textContent = 'Sign In';
    } else {
      signUpTab.className = 'h-10 rounded-lg bg-surface-container-lowest text-primary shadow-sm font-label-lg text-label-lg transition-all flex items-center justify-center';
      signUpTab.setAttribute('aria-selected', 'true');
      signInTab.className = 'h-10 rounded-lg text-on-surface-variant font-label-lg text-label-lg transition-all flex items-center justify-center hover:text-on-surface';
      signInTab.setAttribute('aria-selected', 'false');
      ctaText.textContent = 'Create Account';
    }
  }

  function selectRole(role, btn) {
    const hints = {
      customer: 'Order fresh daily harvests',
      grower: 'Manage your terrace & farm orders',
      delivery: 'Navigate local harvest routes'
    };
    document.getElementById('role-hint').textContent = hints[role];

    document.querySelectorAll('.role-pill').forEach(el => {
      el.className = 'role-pill h-9 rounded-lg text-on-surface-variant font-label-md text-label-md flex items-center justify-center gap-1 transition-all hover:text-on-surface';
    });
    btn.className = 'role-pill h-9 rounded-lg bg-primary text-on-primary font-label-md text-label-md flex items-center justify-center gap-1 shadow-sm transition-all';
  }

  function togglePassword() {
    const input = document.getElementById('password');
    const icon = document.getElementById('eye-icon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  function handleSignIn(e) {
    e.preventDefault();
    const btn = document.getElementById('cta-btn');
    const text = document.getElementById('cta-text');
    const original = text.textContent;
    text.textContent = 'Signing in...';
    btn.classList.add('opacity-80');
    setTimeout(() => {
      text.textContent = original;
      btn.classList.remove('opacity-80');
    }, 900);
  }
</script></main>

