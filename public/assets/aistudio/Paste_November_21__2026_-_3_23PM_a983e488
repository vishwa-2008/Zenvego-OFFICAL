<script>
  (function () {
    const searchInput = document.getElementById('location-search');
    const clearBtn = document.getElementById('clear-search');
    const gpsBtn = document.getElementById('gps-btn');
    const gpsSubtext = document.getElementById('gps-subtext');
    const farmPins = document.querySelectorAll('.farm-pin');
    const farmToast = document.getElementById('farm-toast');
    const addressCards = document.querySelectorAll('.address-card');
    const confirmBtn = document.getElementById('confirm-location-btn');
    let toastTimer = null;

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
    });

    gpsBtn.addEventListener('click', () => {
      gpsSubtext.textContent = 'Detecting nearby terrace farms...';
      setTimeout(() => {
        searchInput.value = 'Kondapur, Hyderabad (GPS)';
        gpsSubtext.textContent = 'Locked: 14 growers within 3 km';
      }, 450);
    });

    farmPins.forEach((pin) => {
      pin.addEventListener('click', () => {
        const name = pin.getAttribute('data-farm');
        const dist = pin.getAttribute('data-dist');
        farmToast.textContent = `${name} • ${dist} away`;
        farmToast.classList.remove('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          farmToast.classList.add('hidden');
        }, 2200);
      });
    });

    addressCards.forEach((card) => {
      card.addEventListener('click', () => {
        const radio = card.querySelector('input[type="radio"]');
        radio.checked = true;
        searchInput.value = radio.value;

        addressCards.forEach((c) => {
          const r = c.querySelector('input[type="radio"]');
          const icon = c.querySelector('.radio-indicator');
          if (r.checked) {
            c.classList.remove('bg-surface-container-low');
            c.classList.add('bg-surface-container-lowest');
            icon.textContent = 'radio_button_checked';
            icon.classList.remove('text-outline');
            icon.classList.add('text-primary');
            icon.style.fontVariationSettings = "'FILL' 1";
          } else {
            c.classList.remove('bg-surface-container-lowest');
            c.classList.add('bg-surface-container-low');
            icon.textContent = 'radio_button_unchecked';
            icon.classList.remove('text-primary');
            icon.classList.add('text-outline');
            icon.style.fontVariationSettings = "'FILL' 0";
          }
        });
      });
    });

    confirmBtn.addEventListener('click', () => {
      const original = confirmBtn.innerHTML;
      confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: \'FILL\' 1;">eco</span><span>Location Confirmed!</span>';
      setTimeout(() => {
        confirmBtn.innerHTML = original;
      }, 1500);
    });
  })();
