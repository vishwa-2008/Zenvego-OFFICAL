<script>
  let activeRole = 'customer';
  const roleNames = {
    customer: 'Customer',
    grower: 'Grower / Farmer',
    delivery: 'Delivery Partner',
    bulk: 'Bulk Buyer'
  };

  function selectRole(role) {
    activeRole = role;
    const cards = ['customer', 'grower', 'delivery', 'bulk'];
    
    cards.forEach((r) => {
      const card = document.getElementById('role-' + r);
      const iconWrap = card.querySelector('div > div > div');
      const radio = card.querySelector('.radio-indicator');
      
      if (r === role) {
        card.classList.add('bg-surface-container-low');
        card.classList.remove('bg-surface-container-lowest');
        iconWrap.classList.add('bg-primary-container', 'text-on-primary');
        iconWrap.classList.remove('bg-surface-container', 'text-primary');
        radio.classList.add('bg-primary', 'text-on-primary');
        radio.classList.remove('bg-surface-container', 'text-transparent');
      } else {
        card.classList.remove('bg-surface-container-low');
        card.classList.add('bg-surface-container-lowest');
        iconWrap.classList.remove('bg-primary-container', 'text-on-primary');
        iconWrap.classList.add('bg-surface-container', 'text-primary');
        radio.classList.remove('bg-primary', 'text-on-primary');
        radio.classList.add('bg-surface-container', 'text-transparent');
      }
    });

    const ctaLabel = document.getElementById('cta-label');
    if (ctaLabel) {
      ctaLabel.textContent = 'Get Started as ' + roleNames[role];
    }
  }

  function handleContinue() {
    const btn = document.getElementById('cta-btn');
    btn.classList.add('scale-95');
    setTimeout(() => {
      btn.classList.remove('scale-95');
      // Visual feedback toast
      const existingToast = document.getElementById('toast-msg');
      if (existingToast) existingToast.remove();

      const toast = document.createElement('div');
      toast.id = 'toast-msg';
      toast.className = 'fixed bottom-6 left-4 right-4 bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-xl shadow-xl flex items-center justify-between z-50 animate-bounce';
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary-fixed text-[20px]">check_circle</span>
          <span class="font-body-md text-body-md">Setting up \${roleNames[activeRole]} experience...</span>
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2400);
    }, 150);
  }

  function handleSignIn() {
    const existingToast = document.getElementById('toast-msg');
    if (existingToast) existingToast.remove();

    const toast = document.createElement('div');
    toast.id = 'toast-msg';
    toast.className = 'fixed bottom-6 left-4 right-4 bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 z-50';
    toast.innerHTML = `
      <span class="material-symbols-outlined text-secondary-fixed text-[20px]">login</span>
      <span class="font-body-md text-body-md">Redirecting to Zenvego Sign In...</span>
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2000);
  }
</script></main>

