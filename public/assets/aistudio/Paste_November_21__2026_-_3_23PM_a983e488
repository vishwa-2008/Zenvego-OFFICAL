<script>
  (function() {
    const qtySpan = document.getElementById('harvest-qty');
    const decBtn = document.getElementById('qty-decrease');
    const incBtn = document.getElementById('qty-increase');
    const publishLabel = document.getElementById('publish-label');
    const publishBtn = document.getElementById('publish-btn');

    let currentQty = 18;

    function updateView() {
      qtySpan.textContent = currentQty;
      publishLabel.textContent = `Publish Live to Neighborhood (${currentQty} kg)`;
    }

    if (decBtn && incBtn && qtySpan) {
      decBtn.addEventListener('click', () => {
        if (currentQty > 1) {
          currentQty -= 1;
          updateView();
        }
      });

      incBtn.addEventListener('click', () => {
        if (currentQty < 100) {
          currentQty += 1;
          updateView();
        }
      });
    }

    if (publishBtn) {
      publishBtn.addEventListener('click', () => {
        publishBtn.innerHTML = `
          <span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span>
          <span>Broadcasting Live Harvest...</span>
        `;
        setTimeout(() => {
          publishBtn.classList.remove('bg-primary');
          publishBtn.classList.add('bg-secondary');
          publishBtn.innerHTML = `
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>Live on Neighborhood Network!</span>
          `;
        }, 1000);
      });
    }
  })();
