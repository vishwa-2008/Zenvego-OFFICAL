  // Dynamic Session Expiry Countdown
  (function initSessionTimer() {
    let timeLeft = 8 * 60 + 45; // 08:45 in seconds
    const timerEl = document.getElementById('sessionTimer');
    if (!timerEl) return;

    const interval = setInterval(() => {
      if (timeLeft <= 0) {
        clearInterval(interval);
        timerEl.textContent = '00:00';
        timerEl.classList.add('text-error');
        return;
      }
      timeLeft--;
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      timerEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }, 1000);
  })();

  // Toggle Order Breakdown Drawer
  const toggleBreakdownBtn = document.getElementById('toggleBreakdownBtn');
  const breakdownDrawer = document.getElementById('breakdownDrawer');
  const breakdownChevron = document.getElementById('breakdownChevron');

  if (toggleBreakdownBtn && breakdownDrawer && breakdownChevron) {
    toggleBreakdownBtn.addEventListener('click', () => {
      const isHidden = breakdownDrawer.classList.contains('hidden');
      if (isHidden) {
        breakdownDrawer.classList.remove('hidden');
        breakdownChevron.style.transform = 'rotate(180deg)';
      } else {
        breakdownDrawer.classList.add('hidden');
        breakdownChevron.style.transform = 'rotate(0deg)';
      }
    });
