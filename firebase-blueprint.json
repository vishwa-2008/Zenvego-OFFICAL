{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated ZENVEGO user profile with role workspace preference (non-admin public roles only).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 24 },
        "activeRole": { "type": "string", "enum": ["customer", "grower", "delivery", "bulk"] },
        "photoURL": { "type": "string", "maxLength": 600 },
        "avatarType": { "type": "string", "enum": ["zenvego", "personal"] },
        "avatarPreset": { "type": "string", "maxLength": 40 },
        "customAvatarData": { "type": "string", "maxLength": 32000 },
        "city": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 240 },
        "deliveryNote": { "type": "string", "maxLength": 200 },
        "organizationName": { "type": "string", "maxLength": 120 },
        "defaultAddressId": { "type": "string", "maxLength": 128 },
        "profileCompleted": { "type": "boolean" },
        "walletBalance": { "type": "number" },
        "savedUpiId": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 24 },
        "favoriteGrowerIds": { "type": "array" },
        "registeredPortals": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "activeRole", "createdAt", "updatedAt"]
    },
    "Address": {
      "title": "Address",
      "description": "Customer saved delivery address with real coordinates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "formattedAddress": { "type": "string", "minLength": 3, "maxLength": 300 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "serviceable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "label", "formattedAddress", "lat", "lng", "serviceable", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Persistent shopping cart item owned by a customer.",
