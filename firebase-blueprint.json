  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account document storing non-admin role workspace preference, avatar choice, protected wallet balance, and editable profile details."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/Address" },
      "description": "Private customer delivery addresses with coordinates."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Private customer shopping cart items."
    },
    "/users/{userId}/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Private user Customer Care tickets and support history."
    },
    "/users/{userId}/wallet_transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Private Green Escrow Wallet passbook transactions."
    },
    "/grower_profiles/{growerId}": {
      "schema": { "$ref": "#/entities/GrowerProfile" },
      "description": "Public urban grower / farmer storefront profile (no private KYC PII)."
    },
    "/grower_kyc/{growerId}": {
      "schema": { "$ref": "#/entities/GrowerKyc" },
      "description": "Private grower KYC documents (phone, ID last-4, live camera selfie, farm proof photo) restricted to owner and authorized reviewers."
    },
    "/delivery_profiles/{partnerId}": {
      "schema": { "$ref": "#/entities/DeliveryProfile" },
      "description": "Private delivery partner KYC, vehicle, and availability profile."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Published produce catalog with real stock counts."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer parent orders containing one or more grower fulfilments."
    },
    "/orders/{orderId}/tracking/{trackingDocId}": {
      "schema": { "$ref": "#/entities/OrderTrackingCurrent" },
      "description": "Current live delivery partner GPS telemetry document (tracking/current) restricted to order participants and written only by the assigned verified delivery partner."
    },
    "/orders/{orderId}/orderEvents/{eventId}": {
      "schema": { "$ref": "#/entities/OrderTrackingEvent" },
      "description": "Append-only delivery status milestone events for an order."
    },
    "/seller_orders/{sellerOrderId}": {
      "schema": { "$ref": "#/entities/SellerOrder" },
      "description": "Per-grower fulfilment orders linked to a parent order."
    },
    "/delivery_assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/DeliveryAssignment" },
      "description": "Hyperlocal delivery assignments restricted to verified delivery partners and order participants."
    },
    "/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "Grower payout allocation and admin-reconciled settlement ledger."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped real-time business event notifications."
    },
    "/bulk_enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/BulkEnquiry" },
      "description": "Institutional buyer wholesale enquiries and grower quotations."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only operator audit logs."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Marketplace pricing and serviceability configuration."
    }
  }
}
