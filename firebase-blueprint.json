        "netPayout": { "type": "number" },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["parentOrderId", "orderCode", "customerId", "customerName", "customerArea", "growerId", "farmName", "status", "handoverPin", "grossAmount", "platformFee", "netPayout", "items", "createdAt", "updatedAt"]
    },
