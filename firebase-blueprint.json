        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "growerId", "quantity", "updatedAt"]
    },
    "GrowerProfile": {
      "title": "GrowerProfile",
      "description": "Public storefront and farm profile for an urban grower or local farmer (zero private KYC PII).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "growerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "farmType": { "type": "string", "maxLength": 80 },
        "areaName": { "type": "string", "maxLength": 160 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "fssaiNumber": { "type": "string", "maxLength": 40 },
        "livenessConfirmed": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "correction_needed", "rejected"] },
        "chemicalFree": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "farmName", "growerName", "farmType", "areaName", "lat", "lng", "verificationStatus", "createdAt", "updatedAt"]
    },
    "GrowerKyc": {
      "title": "GrowerKyc",
      "description": "Private grower KYC document containing sensitive phone, ID last-4, live selfie, and farm proof photo (strictly owner & authorized reviewer only).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone": { "type": "string", "maxLength": 24 },
        "fssaiNumber": { "type": "string", "maxLength": 40 },
        "govIdType": { "type": "string", "enum": ["aadhaar", "pan", "voter_id"] },
        "govIdLast4": { "type": "string", "maxLength": 20 },
        "liveSelfieData": { "type": "string", "maxLength": 32000 },
        "farmPhotoData": { "type": "string", "maxLength": 32000 },
        "livePhotoCapturedAt": { "type": "string", "maxLength": 64 },
        "livenessConfirmed": { "type": "boolean" },
        "reviewStatus": { "type": "string", "enum": ["pending", "verified", "correction_needed", "rejected"] },
        "reviewNote": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "phone", "govIdType", "govIdLast4", "liveSelfieData", "farmPhotoData", "livenessConfirmed", "reviewStatus", "createdAt", "updatedAt"]
    },
    "DeliveryProfile": {
      "title": "DeliveryProfile",
      "description": "Private delivery partner onboarding profile, EV vehicle setup, live photo KYC, and active shift state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partnerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 24 },
        "emergencyPhone": { "type": "string", "maxLength": 24 },
        "vehicleType": { "type": "string", "enum": ["ev", "petrol", "bicycle"] },
        "vehiclePlate": { "type": "string", "maxLength": 32 },
        "dlNumber": { "type": "string", "maxLength": 40 },
        "govIdType": { "type": "string", "enum": ["aadhaar", "pan", "dl"] },
        "govIdLast4": { "type": "string", "maxLength": 20 },
        "liveSelfieData": { "type": "string", "maxLength": 32000 },
        "idDocumentPhotoData": { "type": "string", "maxLength": 32000 },
        "livePhotoCapturedAt": { "type": "string", "maxLength": 64 },
        "livenessConfirmed": { "type": "boolean" },
        "clusterArea": { "type": "string", "maxLength": 120 },
        "availableForDispatch": { "type": "boolean" },
