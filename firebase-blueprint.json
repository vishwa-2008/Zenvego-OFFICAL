        "chemicalFree": { "type": "boolean" },
        "harvestedToday": { "type": "boolean" },
        "image": { "type": "string", "maxLength": 600 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "growerNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["growerId", "farmName", "name", "category", "price", "unit", "unitShort", "stock", "reserved", "harvestedAt", "available", "chemicalFree", "harvestedToday", "image", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer-facing parent order spanning one or more growers.",
      "type": "object",
      "properties": {
        "orderCode": { "type": "string", "maxLength": 32 },
