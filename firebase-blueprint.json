        "reviewNote": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "partnerName", "vehicleType", "clusterArea", "availableForDispatch", "kycStatus", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Live produce listing published by a grower with real atomic stock counts.",
      "type": "object",
      "properties": {
        "growerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "farmName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "variety": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "enum": ["Leafy Greens", "Vegetables", "Heirloom", "Fruits", "Microgreens", "Herbs"] },
        "bedLabel": { "type": "string", "maxLength": 40 },
        "price": { "type": "number" },
        "unit": { "type": "string", "maxLength": 24 },
        "unitShort": { "type": "string", "maxLength": 12 },
        "stock": { "type": "number" },
        "reserved": { "type": "number" },
        "harvestedAt": { "type": "string", "maxLength": 60 },
