        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderCode", "customerId", "customerName", "deliveryAddress", "status", "paymentStatus", "paymentMethod", "itemsTotal", "deliveryFee", "totalPaid", "handoverPin", "growerIds", "items", "createdAt", "updatedAt"]
    },
    "SellerOrder": {
      "title": "SellerOrder",
