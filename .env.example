# APP_URL: The URL where Application A (ZENVEGO Public Marketplace) is hosted.
APP_URL=

# CORS ALLOWLISTS (Comma-separated origins for separate App A & App B deployments)
ALLOWED_PUBLIC_ORIGINS=
ALLOWED_ADMIN_ORIGINS=

# AUTHORIZED OPERATOR EMAILS FOR RESTRICTED REFUND / ADMIN OPERATIONS (Comma-separated)
ADMIN_ALLOWED_EMAILS=

# OPENSTREETMAP / MAPLIBRE / OPENFREEMAP / OSRM / PHOTON CONFIGURATION
# Production deployments should use a commercial SLA or self-hosted style/router/geocoder
# rather than public demo servers.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OSRM_BASE_URL=
GEOCODER_BASE_URL=
NOMINATIM_BASE_URL=
OSM_USER_AGENT=ZenvegoHyperlocal/1.0

# RAZORPAY PAYMENT GATEWAY (Server-side only — never expose secrets to client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CRYPTOGRAPHIC SIGNING SECRET FOR CHECKOUT QUOTES & QR HANDSHAKE TOKENS
# Generate with: openssl rand -hex 32
QR_SIGNING_SECRET=
